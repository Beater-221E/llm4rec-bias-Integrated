# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage

# 虚拟环境
.venv/
venv/
.env
.env.*

# OS / 编辑器
.DS_Store
.ipynb_checkpoints/

# —— 数据与产物（都很大，不进 git）——
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
data/models/**
!data/models/.gitkeep

# artifacts/ 里的 SID 产物值得单独打包分发（见 README「SID 导入」），
# 但不适合进 git —— codebook.pt 几十 MB
artifacts/**
!artifacts/.gitkeep

# 训练输出
runs/**
!runs/.gitkeep
logs/**
!logs/.gitkeep

# wandb 本地缓存
wandb/

# 模型权重
*.pt
*.bin
*.ckpt
*.safetensors
*.npy
*.pkl
